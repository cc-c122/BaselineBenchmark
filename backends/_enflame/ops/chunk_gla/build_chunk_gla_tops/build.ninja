ninja_required_version = 1.3
cxx = c++

cflags = -DTORCH_EXTENSION_NAME=flaggems_chunk_gla_tops_v1 -DTORCH_API_INCLUDE_EXTENSION_H -I/usr/local/lib/python3.12/dist-packages/torch_gcu/include -I/opt/tops/include -I/opt/tops/include/gcu -isystem /usr/local/lib/python3.12/dist-packages/torch/include -isystem /usr/local/lib/python3.12/dist-packages/torch/include/torch/csrc/api/include -isystem /usr/include/python3.12 -fPIC -std=c++17 -O2
post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/usr/local/lib/python3.12/dist-packages/torch_gcu/lib -ltorch_gcu -L/lib -ltopsaten -Wl,-rpath,/usr/local/lib/python3.12/dist-packages/torch_gcu/lib -Wl,-rpath,/lib -L/usr/local/lib/python3.12/dist-packages/torch/lib -lc10 -ltorch_cpu -ltorch -ltorch_python

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc





rule link
  command = $cxx $in $ldflags -o $out

build chunk_gla_tops_extension.o: compile /workspace/FlagGems-vllm/BaselineBenchmark/backends/_enflame/ops/chunk_gla/chunk_gla_tops_extension.cpp





build flaggems_chunk_gla_tops_v1.so: link chunk_gla_tops_extension.o

default flaggems_chunk_gla_tops_v1.so
